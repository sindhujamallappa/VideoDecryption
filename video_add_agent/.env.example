# video-add-agent runtime config (Mode 2: local end-to-end)
#
# UIPATH_URL is the tenant root: <base>/<org>/<tenant>
# The agent appends /odata/... and /dataservice_/api/... to this.
UIPATH_URL=https://staging.uipath.com/ps_india/ProfServ

# Personal Access Token — generate in Automation Cloud:
#   Admin → Tenant settings → Personal Access Tokens → Generate
# Required scopes (matches Agentify app):
#   OR.Buckets.Read OR.Buckets.Write OR.Folders
#   DataFabric.Data.Read DataFabric.Data.Write
UIPATH_ACCESS_TOKEN=
